# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- LLM provider ----------------------------------------------------------
PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Agent limits ----------------------------------------------------------
MAX_STEPS=12

# --- Tools -----------------------------------------------------------------
# Headless-browser page reading (requires: pip install -e ".[browser]" && playwright install chromium)
BROWSER_ENABLED=false
# Clicking / typing / submitting forms on real sites. Leave false until you
# trust what the agent does with it.
BROWSER_ACTIONS_ENABLED=false

# --- Watchers: email -------------------------------------------------------
# Leave IMAP_HOST blank to disable the email watcher.
# For Gmail use an app password, not your account password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
EMAIL_POLL_SECONDS=300

# --- Watchers: marine conditions -------------------------------------------
# Leave the coordinates blank to disable. No API key needed (Open-Meteo).
MARINE_LATITUDE=
MARINE_LONGITUDE=
MARINE_LOCATION_NAME=home waters
MARINE_POLL_SECONDS=1800

# --- Watchers: feeds -------------------------------------------------------
# JSON list of RSS/Atom URLs, e.g. ["https://example.org/notices.rss"]
FEED_URLS=[]
FEED_POLL_SECONDS=1800

# --- Web UI ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
