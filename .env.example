# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- LLM provider ----------------------------------------------------------
PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Agent limits ----------------------------------------------------------
MAX_STEPS=12

# --- Daily brief -----------------------------------------------------------
# One update per branch, generated on start (the service starts at login) and
# then once a day. Each branch costs a single model call, and a branch with
# nothing new costs none. More branches than the budget are batched so the
# total never exceeds it.
DAILY_BRIEF_ENABLED=true
DAILY_BRIEF_MAX_CALLS=5

# --- Reactive rules --------------------------------------------------------
# Off by default: the daily brief is the update path. Rules (rules.json) start
# agent runs whenever a watcher sees something matching, which spends
# unpredictably. Turn on only with an eye on the budget.
RULES_ENABLED=false
MAX_AUTO_RUNS_PER_DAY=12

# --- Tools -----------------------------------------------------------------
# Headless-browser page reading (requires: pip install -e ".[browser]" && playwright install chromium)
BROWSER_ENABLED=false
# Clicking / typing / submitting forms on real sites. Leave false until you
# trust what the agent does with it.
BROWSER_ACTIONS_ENABLED=false

# --- Watchers: email -------------------------------------------------------
# Leave IMAP_HOST blank to disable the email watcher.
# For Gmail use an app password, not your account password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
EMAIL_POLL_SECONDS=300

# --- Branches of interest --------------------------------------------------
# Your branches - one cylinder each in the panel - live in branches.json.
# Copy branches.example.json to change them, add one, or park one.

# --- Web UI ----------------------------------------------------------------
# 127.0.0.1 keeps the panel on this machine only. Change it only together with
# AUTH_TOKEN below.
HOST=127.0.0.1
PORT=8000

# Shared access token. Leave blank ONLY while HOST is 127.0.0.1: without it,
# anyone who can reach the port can read your watchers, spend your API credits
# and call your configured services. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=
# Set true once the panel is served over HTTPS, so the session cookie is only
# sent over TLS. Leave false for plain http, or the cookie is never returned.
COOKIE_SECURE=false
